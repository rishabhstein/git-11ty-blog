---
layout: 'base.njk'
title: Movie/Series Reviews
pagination:
  data: collections.movieArchiveYears
  size: 1
  alias: archiveYear
permalink: "/movies/{{ archiveYear }}/"
eleventyExcludeFromCollections: true
---

<h4>{{ title }}</h4>

<div data-pagefind-ignore>
  <p>
    Years:
    {% for year in collections.movieArchiveYears %}
      <a href="/movies/{{ year }}/">{{ year }}</a>{% if not loop.last %} | {% endif %}
    {% endfor %}
  </p>

  <h4>{{ archiveYear }}</h4>

  {% set yearMovies = collections.movieArchive | itemsForYear(archiveYear) %}
  {% for month in yearMovies | groupByMonth %}
    <section class="archive-month" id="month-{{ month.key }}">
      <h5 class="archive-month-title">
        {{ month.monthName }}
        <span class="archive-month-count">{{ month.items.length }} {% if month.items.length == 1 %}film{% else %}films{% endif %}</span>
      </h5>
      <div class="book-section-grid">
        {% for movie in month.items %}
          <div class="book-entry-grid">
            <a href="{{ movie.url }}" class="book-cover">
              <img src="{{ movie.data.cover | assetUrl }}" alt="{{ movie.title }}">
              <div class="star-rating">
                {% for i in range(movie.data.rating) %}⭐{% endfor %}
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</div>
