---
    layout: 'base.njk'
---

<!-- <h1>{{ title }}</h1> -->

<ul class="blog-posts">
    {% for post in collections.microfeed | reverse %}
            <li>
                {% renderTemplate "liquid", post %}
                <span>{{ date | date: "%b %d, %Y" }}</span>
                {% endrenderTemplate %}
                 —
                <a href="{{ post.url }}">{{ post.data.title }}</a>
            </li>
    {% endfor %}
</ul>
