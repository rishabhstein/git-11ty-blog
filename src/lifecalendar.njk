---
title: Life Calendar
layout: base.njk
---

{% set totalWeeks = lifeline.lifespan * lifeline.weeksInYear %}
{% set weeksPerDecade = 10 * lifeline.weeksInYear %}
{% set totalDecades = (totalWeeks / weeksPerDecade) | round(0, 'ceil') %}

<h1>{{ title }}</h1>
Each box represents a week with color indicating:
<div class="legend">
  <span class="week lived legend-box"></span> Lived weeks <br>
  <span class="week legend-box"></span> Future weeks <br>
  <span class="week lived milestone legend-box legend-milestone"></span> Milestones
</div>

<br>

<div class="calendar-container">
  <div class="weeks-label">Weeks →</div>
  <div class="calendar">
    {% for decadeIndex in range(0, totalDecades - 1) %}
      {% set decadeStart = decadeIndex * weeksPerDecade + 1 %}
      {% set decadeEnd = decadeStart + weeksPerDecade - 1 %}
      {% if decadeEnd > totalWeeks %}
        {% set decadeEnd = totalWeeks %}
      {% endif %}

      <div class="decade-row">
        <div class="decade-label">{{ decadeIndex * 10 }}s</div>
        <div class="decade-grid">
          {% for week in range(decadeStart, decadeEnd) %}
            {% set milestone = null %}
            {% for m in lifeline.milestones %}
              {% if m.week == week %}
                {% set milestone = m %}
              {% endif %}
            {% endfor %}

            <div
              class="week {% if week <= lifeline.weeksLived %}lived{% endif %} {% if milestone %}milestone{% endif %}"
              {% if milestone %}
                title="{{ milestone.date }} - {{ milestone.label }}"
                data-label="{{ milestone.label }}"
                data-date="{{ milestone.date }}"
              {% endif %}>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>


<style>

.legend span {
  margin-right: 12px;
}

.legend-box {
  display: inline-block;   /* THIS is the key */
  width: 12px;
  height: 12px;
  vertical-align: middle;
  margin-right: 6px;
}
.legend-milestone {
  background: #e53935 !important;
  border: 2px solid #e53935;
}


.calendar {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 20px 0;
}

.decade-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.decade-label {
  width: 40px;
  flex: 0 0 40px;
  font-size: 14px;
  line-height: 1.2;
  color: #555;
}

.decade-grid {
  display: grid;
  grid-template-columns: repeat(52, minmax(0, 1fr));
  gap: 1px;
  flex: 1 1 auto;
  max-width: 100%;
}

.decade-grid .week {
  width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  min-width: 0;
}

/* Default non-lived week */
.week {
  width: 12px;
  height: 12px;
  background: transparent; /* transparent fill */
  border: 1px solid #333; /* dark edge */
  box-sizing: border-box;
}

/* Weeks already lived */
.week.lived {
  background: #4caf50; /* green */
  border: 1px solid #4caf50;
}

/* Milestones */
.week[title] {
  border: 1px solid #e53935; /* red border for milestone */
  position: relative;
  cursor: pointer;
}

.week[title].lived {
  background: #e53935; /* keep green fill for lived milestone */
}

/* Optional: scale effect on hover for milestones */
.week[title]:hover {
  transform: scale(1.3);
  transition: transform 0.2s;
}

.milestone-popup {
  position: absolute;
  background: #fff;
  border: 1px solid #e53935;
  padding: 4px 8px;
  border-radius: 4px;
  color: #333;
  font-size: 18px;
  z-index: 10;
  display: none;
  pointer-events: none;
  white-space: pre; /* respects \n line breaks */
}

</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const calendar = document.querySelector(".calendar");
  if (!calendar) return;

  const popup = document.createElement("div");
  popup.className = "milestone-popup";
  document.body.appendChild(popup);

  calendar.querySelectorAll(".week.milestone").forEach(week => {
    week.addEventListener("click", (e) => {
      e.stopPropagation();
      const label = week.getAttribute("data-label");
      const date = week.getAttribute("data-date");
      popup.textContent = `${date}\n${label}`;
      const rect = week.getBoundingClientRect();
      popup.style.top = rect.top + window.scrollY - popup.offsetHeight - 5 + "px";
      popup.style.left = rect.left + window.scrollX + "px";
      popup.style.display = "block";
    });
  });

  document.addEventListener("click", () => {
    popup.style.display = "none";
  });
});

</script>
