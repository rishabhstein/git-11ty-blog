---
title: Welcome
layout: 'base.njk'
---



<div class="portal-layout home-index">
  <div class="home-status-strip">
    <div class="geocities-strip" aria-label="Retro animated badges">
      <span class="geo-badge blink">STATUS:</span>
      <marquee class="geo-marquee" behavior="scroll" direction="left" scrollamount="5">
        <span id="geo-status-marquee-text" data-statuscafe-user="sigmarootpi">Loading latest Status Cafe update...</span>
      </marquee>
    </div>
  </div>

  <div class="portal-center">
    {% set recentPosts = collections.post | reverse %}

    {% set latestItem = collections.siteActivity[0] %}
    {# Whatever is featured in full above is filtered out of the listings below. #}
    {% set featuredUrl = latestItem.url if latestItem else "" %}
    {% if latestItem %}
    {% set latestTags = latestItem.data.tags %}
    {% set isBook = "books" in latestTags %}
    {% set isMovie = "movies" in latestTags %}
    {% set isSnap = "snap" in latestTags %}
    {% set latestCoverUrl = latestItem.data.cover | assetUrl %}

    <article class="home-latest-post">
      <span class="home-latest-kicker">
        Latest Post
      </span>

      <h1><a href="{{ latestItem.url }}" class="u-url p-name">{{ latestItem.data.title }}</a></h1>
      <h3>{{ latestItem.date | postDate }}</h3>

      {% if latestTags %}
      <p>Tags:
        {% for tag in latestTags %}
          <a href="/tags/{{ tag | slug }}/">#{{ tag }}</a>{% if not loop.last %} {% endif %}
        {% endfor %}
      </p>
      {% endif %}

      {% if "word-vomit" in latestTags %}
      <blockquote>
        <p>This post is a part of my word-vomit series. Feel free to skip it.</p>
      </blockquote>
      {% endif %}

      {% if (isBook or isMovie) and latestCoverUrl %}
      <section class="book-post-hero" aria-label="{% if isBook %}Book{% else %}Movie{% endif %} details">
        <div class="book-post-cover">
          <img src="{{ latestCoverUrl }}" alt="Cover of {{ latestItem.data.title }}">
        </div>

        <div class="movie-post-details">
          <dl class="book-post-meta">
            <div>
              <dt>Title</dt>
              <dd>{{ latestItem.data.title | replace("Book review:", "") | trim }}</dd>
            </div>

            {% if latestItem.data.author %}
            <div>
              <dt>Author</dt>
              <dd>{{ latestItem.data.author }}</dd>
            </div>
            {% endif %}

            {% if latestItem.data.director %}
            <div>
              <dt>Director</dt>
              <dd>{{ latestItem.data.director }}</dd>
            </div>
            {% endif %}

            {% if latestItem.data.rating %}
            <div>
              <dt>My rating</dt>
              <dd>
                <span class="book-post-stars" aria-label="{{ latestItem.data.rating }} out of 5">
                  {% for i in range(5) %}{% if i < latestItem.data.rating %}★{% else %}☆{% endif %}{% endfor %}
                </span>
                <span class="book-post-rating-text">{{ latestItem.data.rating }}/5</span>
              </dd>
            </div>
            {% endif %}

            {% if latestItem.data.location %}
            <div>
              <dt>Location</dt>
              <dd>{{ latestItem.data.location }}</dd>
            </div>
            {% endif %}

            {% if latestItem.data.sdate %}
            <div>
              <dt>Start date</dt>
              <dd><time datetime="{{ latestItem.data.sdate | isoDate }}">{{ latestItem.data.sdate | postDate }}</time></dd>
            </div>
            {% endif %}

            {% if latestItem.data.fdate %}
            <div>
              <dt>Finish date</dt>
              <dd><time datetime="{{ latestItem.data.fdate | isoDate }}">{{ latestItem.data.fdate | postDate }}</time></dd>
            </div>
            {% endif %}

            {% if isMovie %}
            <div>
              <dt>Watched on</dt>
              {% if latestItem.data.wdate %}
              <dd><time datetime="{{ latestItem.data.wdate | isoDate }}">{{ latestItem.data.wdate | postDate }}</time></dd>
              {% else %}
              <dd><time datetime="{{ latestItem.date | isoDate }}">{{ latestItem.date | postDate }}</time></dd>
              {% endif %}
            </div>
            {% endif %}
          </dl>
        </div>
      </section>
      {% endif %}

      {% if isSnap and latestItem.data.comment %}
      <p>{{ latestItem.data.comment | safe }}</p>
      {% endif %}

      {% if not (isBook or isMovie) and latestCoverUrl and not (latestCoverUrl in latestItem.content) and not (latestItem.data.cover in latestItem.content) %}
      <figure class="writing-post-cover">
        <img src="{{ latestCoverUrl }}" alt="Cover for {{ latestItem.data.title }}">
      </figure>
      {% endif %}

      {{ latestItem.content | safe }}
    </article>
    {% endif %}

    <a href="/archives/" class="section-title-link"><h4 class="telegraph-section-title">Writings</h4></a>

    <section class="section writing-layout">
      <div class="writing-row-one">
        <ul class="entry-list">
          {% for post in recentPosts | excludeUrl(featuredUrl) %}
            {% if loop.index <= 6 %}
            <li class="entry-item{% if post.data.highlight %} writing-highlight{% endif %}">
              <a href="{{ post.url }}" class="u-url p-name entry-title">{{ post.data.title }}</a>
              <span class="entry-meta">
                {% for tag in post.data.tags %}{% if tag != "post" %}<a href="/tags/{{ tag | slug }}/">#{{ tag }}</a>{% endif %}{% endfor %}
                <span class="entry-sep">|</span>
                <time datetime="{{ post.date | isoDate }}">{{ post.date | postDate }}</time>
              </span>
            </li>
            {% endif %}
          {% endfor %}
        </ul>

        <article class="writing-piclog">
          <a href="{{ piclogImage }}">
            <span class="piclog-overlay">Picture of the Day</span>
            <img
              src="{{ piclogImage }}"
              alt="Picture of the Day"
              class="piclog-image"
            >
          </a>
        </article>
      </div>
    </section>

    <div class="home-media-columns">
      <section class="home-media-col">
        <a href="/movies/" class="section-title-link"><h4 class="telegraph-section-title">Movies</h4></a>
        <div class="home-cover-row">
          {% set recentMovies = collections.movies | sort(attribute='date') | reverse %}
          {% for movie in recentMovies | excludeUrl(featuredUrl) %}
            {% if loop.index <= 3 %}
              <a href="{{ movie.url }}" class="home-cover" title="{{ movie.data.title }}">
                <img src="{{ movie.data.cover | assetUrl }}" alt="{{ movie.data.title }}">
                {% if movie.data.rating %}
                <span class="home-cover-rating">
                  {% for i in range(5) %}{% if i < movie.data.rating %}★{% endif %}{% endfor %}
                </span>
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </section>

      <section class="home-media-col">
        <a href="/books/" class="section-title-link"><h4 class="telegraph-section-title">Books</h4></a>
        <div class="home-cover-row">
          {% set recentBooks = collections.books | sort(attribute='date') | reverse %}
          {% for book in recentBooks | excludeUrl(featuredUrl) %}
            {% if loop.index <= 3 %}
              <a href="{{ book.url }}" class="home-cover" title="{{ book.data.title }}">
                <img src="{{ book.data.cover | assetUrl }}" alt="{{ book.data.title }}">
                {% if book.data.rating %}
                <span class="home-cover-rating">
                  {% for i in range(5) %}{% if i < book.data.rating %}★{% endif %}{% endfor %}
                </span>
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    </div>

    <a href="/snap/" class="section-title-link"><h4 class="telegraph-section-title">Photos</h4></a>

    <div class="home-snap-row">
      {% set recentSnaps = collections.snap | reverse %}
      {% for snap in recentSnaps | excludeUrl(featuredUrl) %}
        {% if loop.index <= 4 %}
          <a href="{{ snap.url }}" class="home-snap" title="{{ snap.data.title }}">
            <img src="{{ snap.data.cover | assetUrl }}" alt="{{ snap.data.title }}">
            <span class="home-snap-caption">{{ snap.data.title }}</span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  <br>
  </div>
</div>
