---
    layout: 'base.njk'
---

<h4>Gallery</h4>

<div data-pagefind-ignore>
  <section>
  <div class="gallery">
      {% for post in collections.snap | reverse %}
                   <div>
                      <a href="{{ post.url }}"><img src="{{ post.data.cover | assetUrl }}"></a>
                  </div>
      {% endfor %}
  </div>
  </section>
</div>
