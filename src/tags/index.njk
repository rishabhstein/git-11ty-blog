---
layout: 'tags.njk'
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag }}/
---

<h4>Filter: /tags/{{ tag }}</h4>
<ul class="entry-list">
  {% for post in collections.all | postsByTagInsensitive(tag) %}
    <li class="entry-item">
      <a href="{{ post.url }}" class="entry-title">{{ post.data.title }}</a>
      <time class="entry-date" datetime="{{ post.date | isoDate }}">{{ post.date | postDate }}</time>
    </li>
  {% endfor %}
</ul>
