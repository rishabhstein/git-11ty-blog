---
layout: 'tags.njk'
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: /tags/{{ tag }}/
---

<h4>Filter: /tags/{{ tag }}</h4>
<ul>
  {% for post in collections.all | postsByTagInsensitive(tag) %}
    <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
  {% endfor %}
</ul>
