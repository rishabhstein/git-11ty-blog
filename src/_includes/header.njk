<header class="page-header">
  <a href="https://sigmarootpi.com/" class="h-card" rel="me" style="display:none;">Cogito, ergo sum</a>
<body>

<!-- Writing the main heading of my Weblog -->
<div class="jumbotron">
    <h1><a href="/">Sigmarootpi (&#963;&#8730;&#960)</a></h1>
</div>
  
<div class="menu-bar" style="display: flex; flex-wrap:wrap; justify-content: space-between; align-items: center;">
  <div style="display: flex; gap: 4px; align-items: center;">
    <span><a href="/about/"><img src="/assets/icons/fb-info.png" class="icon-emoji"></a> |</span>
    <span><a href="/archives/"><img src="/assets/icons/fb-post.png" class="icon-emoji"></a> |</span>
    <span><a href="/snap/"><img src="/assets/icons/fb-photos.png" class="icon-emoji"></a> |</span>
    <span><a href="/guestbook/"><img src="/assets/icons/fb-request.png" class="icon-emoji"></a> |</span>
    <span><a href="https://notes.sigmarootpi.com"><img src="/assets/icons/fb-notes.png" class="icon-emoji"></a> |</span>
    <span><a href="/explore/"><img src="/assets/icons/fb-friend.png" class="icon-emoji"></a> |</span>
    <span><a href="/search/"><img src="/assets/icons/fb-search.png" class="icon-emoji"></a> |</span>
    <span><a href="/subscribe/"> <img src="/assets/icons/RSSIcon16x16.png" class="icon-emoji"> </a></span>
  </div>

{% set lastPost = collections.combinedFeed | sort(attribute="date") | last %}
  <div style="display: flex; align-items: center; gap: 4px;">
    <svg width="8" height="8" viewBox="0 0 8 8" xmlns="http://www.w3.org/2000/svg">
      <circle cx="4" cy="4" r="4" fill="#4caf50"/>
    </svg> 
    <span>Last post {{ lastPost.date | timeAgo }}</span>
  </div>

</div>
<hr>
</header>