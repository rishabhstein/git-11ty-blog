{% set workoutItem = workoutLogItem %}
{% set workoutMeta = [] %}
{% if workoutItem.data.distance %}{% set workoutMeta = (workoutMeta.push(workoutItem.data.distance + " km"), workoutMeta) %}{% endif %}
{% if workoutItem.data.duration %}{% set workoutMeta = (workoutMeta.push(workoutItem.data.duration | formatWorkoutDuration), workoutMeta) %}{% endif %}
{% if workoutItem.data.calories %}{% set workoutMeta = (workoutMeta.push(workoutItem.data.calories + " cal"), workoutMeta) %}{% endif %}
{% if workoutItem.data.average_heart_rate %}{% set workoutMeta = (workoutMeta.push(workoutItem.data.average_heart_rate + " bpm"), workoutMeta) %}{% endif %}
{% set workoutDetails = [] %}
{% if workoutItem.data.workout_type %}{% set workoutDetails = (workoutDetails.push(["Type", workoutItem.data.workout_type]), workoutDetails) %}{% endif %}
{% if workoutItem.data.distance %}{% set workoutDetails = (workoutDetails.push(["Distance", workoutItem.data.distance + " km"]), workoutDetails) %}{% endif %}
{% if workoutItem.data.duration %}{% set workoutDetails = (workoutDetails.push(["Duration", workoutItem.data.duration | formatWorkoutDuration]), workoutDetails) %}{% endif %}
{% if workoutItem.data.calories %}{% set workoutDetails = (workoutDetails.push(["Calories", workoutItem.data.calories]), workoutDetails) %}{% endif %}
{% if workoutItem.data.average_heart_rate %}{% set workoutDetails = (workoutDetails.push(["Average heart rate", workoutItem.data.average_heart_rate + " bpm"]), workoutDetails) %}{% endif %}
{% if workoutItem.data.source %}{% set workoutDetails = (workoutDetails.push(["Source", workoutItem.data.source]), workoutDetails) %}{% endif %}

<details class="workout-log-item">
  <summary class="workout-log-summary">
    <span class="workout-log-date">{{ workoutItem.date | postDate }}</span>
    <span class="workout-log-title">{{ workoutItem.data.title }}</span>
    {% if workoutMeta.length %}
      <span class="workout-log-meta">
        {% for item in workoutMeta %}
          <span>{{ item }}</span>{% if not loop.last %}<span> · </span>{% endif %}
        {% endfor %}
      </span>
    {% endif %}
  </summary>

  <div class="workout-log-body">
    {% if workoutDetails.length %}
      <ul class="workout-detail-list">
        {% for item in workoutDetails %}
          <li><strong>{{ item[0] }}:</strong> {{ item[1] }}</li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if workoutItem.templateContent | trim %}
      <div class="workout-summary-block">
        <h5>Summary</h5>
        {{ workoutItem.templateContent | safe }}
      </div>
    {% endif %}
  </div>
</details>
