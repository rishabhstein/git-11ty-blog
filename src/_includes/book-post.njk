---
    layout: 'base.njk'
---


<article class="main-article book-post{% if not (content | striptags | trim) %} no-review-text{% endif %}">

<h1 data-pagefind-meta="title">{{ title }}</h1>

<div class="container-narrow">
          <main>
            {# Test: only the cover sits with the text (the review wraps around
               it); the details moved to the table at the end of the post. #}
            {% if cover %}
            <figure class="review-cover">
              <img src="{{ cover | assetUrl }}" alt="Cover of {{ title }}">
              {% if rating %}
              <span class="review-cover-stars" aria-label="My rating: {{ rating }} out of 5">{% for i in range(5) %}{% if i < rating %}★{% else %}☆{% endif %}{% endfor %}</span>
              {% endif %}
            </figure>
            {% endif %}
            {{ content | safe }}
        </main>
</div>

{% include "post-footer.njk" %}
</article>
