{% if site.webmentionEndpoint %}
<section class="webmention-box" id="webmentions" aria-labelledby="webmention-title">
  <h3 id="webmention-title">Send a webmention</h3>
  <form class="webmention-form" action="{{ site.webmentionEndpoint }}" method="post">
    <label for="webmention-source">Your post URL</label>
    <div class="webmention-form-row">
      <input
        id="webmention-source"
        name="source"
        type="url"
        inputmode="url"
        placeholder="https://your-site.example/my-reply"
        required
      >
      <input type="hidden" name="target" value="{{ site.url }}{{ page.url }}">
      <button type="submit">Send</button>
    </div>
  </form>
</section>
{% endif %}

{% webmentionsFor site.url ~ page.url %}
