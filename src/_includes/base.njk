<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="sigmarootpi">


    <!-- Open Graph -->
    <meta property="og:title" content="{{ title }}">
    <meta property="og:image" content="{{ cover | url }}">
    <meta property="og:url" content="{{ page.url | url }}">

    <!-- Twitter -->
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:image" content="{{ cover | url }}">

    <!-- Mastodon -->
    <a rel="me" href="https://mastodon.social/@sigmarootpi" style="display:none;">Mastodon</a>

    <!-- Adding github for IndieAuth -->
    <link rel="me" href="https://github.com/rishabhstein">

    <!-- Le styles -->
    <link rel="stylesheet" href="/assets/css/style.css?v=1.0">
    <link rel="stylesheet" href="/assets/css/mastodon.css?v=2.0">
    <link rel="stylesheet" href="/assets/css/snow.css?v=2.0">

    <!-- Fav and touch icons -->
    <link rel="icon" type="image/png" href="/assets/logo.png">

    <link rel="alternate" type="application/rss+xml" title="Rishabh's Blog Feed" href="/feed.xml" />
    <script src="/assets/js/sidebar.js" defer></script>
    <audio id="sidebar-music" src="/assets/sounds/Dean Martin - Let It Snow.mp3" preload="auto" loop></audio>

</head>
<body>

    <!-- Its Christmas time -->
<div id="snow-zone">
  <span class="snow-particle" style="--x:5vw; --size:6px; --duration:6s; --delay:0s;"></span>
  <span class="snow-particle" style="--x:15vw; --size:8px; --duration:7s; --delay:0.5s;"></span>
  <span class="snow-particle" style="--x:25vw; --size:7px; --duration:5.5s; --delay:5s;"></span>
  <span class="snow-particle" style="--x:35vw; --size:9px; --duration:6.5s; --delay:3s;"></span>
  <span class="snow-particle" style="--x:45vw; --size:8px; --duration:7.5s; --delay:0.8s;"></span>
  <span class="snow-particle" style="--x:55vw; --size:6px; --duration:6s; --delay:2s;"></span>
  <span class="snow-particle" style="--x:65vw; --size:9px; --duration:7s; --delay:3s;"></span>
  <span class="snow-particle" style="--x:75vw; --size:7px; --duration:5.8s; --delay:10s;"></span>
  <span class="snow-particle" style="--x:85vw; --size:8px; --duration:6.5s; --delay:7s;"></span>
  <span class="snow-particle" style="--x:95vw; --size:9px; --duration:7.2s; --delay:0.9s;"></span>
</div>
<!-- ####################### -->



    {% include 'header.njk' %}
    <main>
    <button class="toggle-sidebar">🎶 Live Feed</button>
    <div class="layout-wrapper">
    <div class="main-content">

      {{ content | safe }}

    </div> <!--main content end-->

    <div class="right-column"> 
      <!-- Right Sidebar Column -->  
      <h3><img src="/assets/icons/fb-announce.png" class="icon-emoji"> Status </h3>
      <div class="section">
      <section class="livestatus"> 
          <div id="statuscafe">
            <div id="statuscafe-username"></div>
            <div id="statuscafe-content"></div>
          </div>
          <script src="https://status.cafe/current-status.js?name=sigmarootpi" defer></script>
        </section>
        </div>

  <h3><img src="/assets/icons/fb-wall.png" class="icon-emoji"> Mini-feed<a href="https://mastodon.social/@sigmarootpi"><img src="/assets/icons/click.png" class="icon-emoji"></a></h3>
        <div class="section">
            <div id="mt-container" class="mt-container">
              <div class="mt-body" role="feed">
                <div class="mt-loading-spinner"></div>
              </div>
            </div>
        </div>

    </div>

    <div class="overlay"></div>

    </div> <!-- layout-wrapper end -->
    </main>
    
    {% include 'footer.njk' %}


    <!-- For Mastodon Feed -->
    <script src="/assets/js/mastodon.js"></script>
    <script>
        const myTimeline = new MastodonTimeline.Init({
          instanceUrl: "https://mastodon.social",
          timelineType: "profile",
          userId: "115311770892730280",
          profileName: "@sigmarootpi",
          maxNbPostShow: "5",
          txtMaxLines: "3",
        });
      </script>


  
</body>
</html>
