  <!-- rest of your layout here -->

    {% include 'header.njk' %}
    <main>
    <button class="toggle-sidebar">🎶 Music</button>
    <div class="layout-wrapper">
    {% if page.url == "/" %}
    <div class="main-content home-shell" data-pagefind-body>
      {{ content | safe }}
    </div> <!--main content end-->
    {% else %}
    <div class="portal-layout">
      <aside class="portal-left">
        <h3>Blogroll</h3>
        {% include "blogroll-snippet.njk" %}
        <p>
          <a href="/guestbook/">
            <img src="https://www.gifs.cc/guestbook/sign-guestbook-animation.gif" alt="Sign my guestbook" data-no-image-reveal>
          </a>
        </p>

        {% postrollItems %}
        {% bearblogDiscoveryItems %}
        {% include "fantastic-web-snippet.njk" %}
      </aside>
      <div class="main-content portal-center" data-pagefind-body>
        {{ content | safe }}
      </div> <!--main content end-->
      <aside class="portal-right">
        <a href="/feed.xml" class="rss-panel-gif" title="Subscribe to RSS feed">
          <span class="rss-panel-left">RSS</span>
          <span class="rss-panel-mid">
            <span class="rss-panel-mid-line rss-line-1">There is more to the story</span>
            <span class="rss-panel-mid-line rss-line-2">Subscribe</span>
            <span class="rss-panel-mid-line rss-line-3">CLICK HERE</span>
          </span>
          <span class="rss-panel-right">CLICK HERE</span>
        </a>

        {% set activityHeatmapItems = collections.workoutArchive %}
        {% set activityHeatmapTitle = "Sport Activity" %}
        {% set activityHeatmapLabelSingular = "workout" %}
        {% set activityHeatmapLabelPlural = "workouts" %}
        {% set activityHeatmapTitleUrl = "/workout/" %}
        {% if collections.workoutArchive.length %}
          {% set activityHeatmapInitialMonth = collections.workoutArchive[0].date | isoDate %}
        {% endif %}
        {% set activityHeatmapMonthLinkPrefix = (site.pathPrefix or "/") ~ "workout/" %}
        {% include "activity-heatmap.njk" %}

        <h3><a href="/workout/">Recent Activity</a></h3>
        <ul class="portal-list sidebar-activity-list">
          {% for workout in collections.workoutArchive %}
            {% if loop.index <= 4 %}
              <li>
                <a href="/workout/{{ workout.date.getFullYear() }}/#month-{{ workout.date | monthKey }}">{{ workout.data.title }}</a>
                <span class="sidebar-activity-meta">{{ workout.date | postDate }}{% if workout.data.distance %} · {{ workout.data.distance }} km{% endif %}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        <h3><a href="/tags/">Tags</a></h3>
        <ul class="portal-list">
          {% for tag in collections.tagList %}
            {% if loop.index <= 14 %}
              <li><a href="/tags/{{ tag | slug }}/">{{ tag }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>

        <h3>Word-vomit series</h3>
        <ul class="portal-list">
          {% for post in collections["word-vomit"] | reverse %}
            {% if loop.index <= 5 %}
              <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
            {% endif %}
          {% endfor %}
          <li><a href="/tags/word-vomit/"><strong>More..</strong></a></li>
        </ul>
      </aside>
    </div>
    {% endif %}

    <div class="right-column">
      <!-- Right Sidebar Column -->
      <h3><img src="/assets/icons/fb-announce.png" class="icon-emoji" data-no-image-reveal> Status </h3>
      <div class="section">
        <section class="livestatus">
          <div
            id="statuscafe"
            style="background: var(--panel-bg); color: var(--text-color); border: 1px solid var(--panel-border); border-radius: 12px; padding: 10px; box-shadow: var(--panel-shadow);"
          >
            <div id="statuscafe-username"></div>
            <div id="statuscafe-content"></div>
          </div>
          <script src="https://status.cafe/current-status.js?name=sigmarootpi" defer></script>
        </section>
      </div>
    </div>

    <div class="overlay"></div>

    </div> <!-- layout-wrapper end -->
    </main>

    <div class="layout-wrapper layout-wrapper-footer">
      {% include 'footer.njk' %}
    </div>

</body>
</html>
