<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set socialTitle = title or site.name %}
    {% set socialType = "article" if layout in ["post.njk", "snap.njk", "book-post.njk", "movie-post.njk"] else "website" %}
    {# Only articles get an auto-excerpt; listing pages would just echo their own scaffolding. #}
    {% set socialDescription = description or (page.rawInput | socialExcerpt if socialType == "article" else site.description) %}
    {% set socialImage = (cover or "/assets/logo.png") | toAbsoluteUrl %}
    {% set socialUrl = page.url | toAbsoluteUrl %}
    <meta name="description" content="{{ socialDescription }}">
    <meta name="author" content="sigmarootpi">
    <link rel="canonical" href="{{ socialUrl }}">

    <!-- Open Graph (WhatsApp, Signal, Mastodon, Facebook, LinkedIn, ...) -->
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:type" content="{{ socialType }}">
    <meta property="og:title" content="{{ socialTitle }}">
    <meta property="og:description" content="{{ socialDescription }}">
    <meta property="og:url" content="{{ socialUrl }}">
    <meta property="og:image" content="{{ socialImage }}">
    <meta property="og:image:alt" content="{{ socialTitle }}">
    {% if socialType == "article" and page.date %}
    <meta property="article:published_time" content="{{ page.date | isoDate }}">
    {% endif %}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ socialTitle }}">
    <meta name="twitter:description" content="{{ socialDescription }}">
    <meta name="twitter:image" content="{{ socialImage }}">
    {% set siteRoot = site.pathPrefix or "/" %}
    <script>
      window.__SITE_PATH_PREFIX__ = "{{ siteRoot }}";
    </script>

    <!-- Adding github for IndieAuth -->
    <link rel="me" href="https://github.com/rishabhstein">
    {% if site.webmentionEndpoint %}
    <link rel="webmention" href="{{ site.webmentionEndpoint }}">
    {% endif %}
    <link href="{{ siteRoot }}pagefind/pagefind-ui.css" rel="stylesheet">
    <style>
      @media (prefers-color-scheme: dark) {
        :root {
          --pagefind-ui-primary: #eeeeee;
          --pagefind-ui-text: #eeeeee;
          --pagefind-ui-background: #152028;
          --pagefind-ui-border: #152028;
          --pagefind-ui-tag: #152028;
        }
      }
    </style>

    <!-- Le styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="{{ siteRoot }}assets/css/style.css?v=12.6">
    <!-- <link rel="stylesheet" href="/assets/css/snow.css?v=1.0">
    <link rel="stylesheet" href="/assets/css/christmas-light.css"> -->


    <!-- Fav and touch icons -->
    <link rel="icon" type="image/png" href="/assets/logo.png">

    <link rel="alternate" type="application/rss+xml" title="Rishabh's Blog Feed" href="/feed.xml" />

    <script src="{{ siteRoot }}assets/js/activity-heatmap.js" defer></script>
    <script src="{{ siteRoot }}assets/js/workout-tabs.js" defer></script>
    <script src="{{ siteRoot }}assets/js/status-ticker.js" defer></script>
    <script src="{{ siteRoot }}pagefind/pagefind-ui.js" defer></script>
    <script src="{{ siteRoot }}assets/js/pagefind-init.js" defer></script>
    <script src="{{ siteRoot }}assets/js/cat-cursor.js?v=3" defer></script>

</head>
<body class="{{ pageClass or '' }}">
