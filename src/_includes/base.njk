<!DOCTYPE html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="sigmarootpi">
    {% set siteRoot = site.pathPrefix or "/" %}
    <script>
      document.documentElement.classList.remove("no-js");
      document.documentElement.classList.add("js");
      window.__SITE_PATH_PREFIX__ = "{{ siteRoot }}";
    </script>

    <!-- Adding github for IndieAuth -->
    <link rel="me" href="https://github.com/rishabhstein">
    {% if site.webmentionEndpoint %}
    <link rel="webmention" href="{{ site.webmentionEndpoint }}">
    {% endif %}
    <link href="{{ siteRoot }}pagefind/pagefind-ui.css" rel="stylesheet">
    <style>
      @media (prefers-color-scheme: dark) {
        :root {
          --pagefind-ui-primary: #eeeeee;
          --pagefind-ui-text: #eeeeee;
          --pagefind-ui-background: #152028;
          --pagefind-ui-border: #152028;
          --pagefind-ui-tag: #152028;
        }
      }
    </style>

    <!-- Le styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="{{ siteRoot }}assets/css/style.css?v=3.8">
    <!-- <link rel="stylesheet" href="/assets/css/snow.css?v=1.0">
    <link rel="stylesheet" href="/assets/css/christmas-light.css"> -->


    <!-- Fav and touch icons -->
    <link rel="icon" type="image/png" href="/assets/logo.png">

    <link rel="alternate" type="application/rss+xml" title="Rishabh's Blog Feed" href="/feed.xml" />

    <script src="{{ siteRoot }}assets/js/sidebar.js" defer></script>
    <script src="{{ siteRoot }}assets/js/mobile-sidebar-sections.js" defer></script>
    <script src="{{ siteRoot }}assets/js/activity-heatmap.js" defer></script>
    <script src="{{ siteRoot }}assets/js/workout-tabs.js" defer></script>
    <script src="{{ siteRoot }}assets/js/geocities-loader.js" defer></script>
    <script src="{{ siteRoot }}assets/js/status-ticker.js" defer></script>
    <script src="{{ siteRoot }}assets/js/image-reveal.js?v=2.5" defer></script>
    <script src="{{ siteRoot }}pagefind/pagefind-ui.js" defer></script>
    <script src="{{ siteRoot }}assets/js/pagefind-init.js" defer></script>
    <audio id="sidebar-music" src="/assets/sounds/blog_background.mp3" preload="auto" loop></audio>
    <audio id="focus-mode-sound" src="/assets/sounds/angel-harp.mp3" preload="auto"></audio>

</head>
<body class="{{ pageClass or '' }}">
<script>
  try {
    if (sessionStorage.getItem("focus-mode-enabled") === "1") {
      document.body.classList.add("focus-mode");
    }
  } catch (error) {
    // Ignore storage failures and let the deferred script restore state later.
  }
</script>
