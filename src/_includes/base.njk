<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ title }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="">
    <meta name="author" content="sigmarootpi">


    <!-- Open Graph -->
    <meta property="og:title" content="{{ title }}">
    <meta property="og:image" content="{{ cover | url }}">
    <meta property="og:url" content="{{ page.url | url }}">

    <!-- Twitter -->
    <meta name="twitter:title" content="{{ title }}">
    <meta name="twitter:image" content="{{ cover | url }}">

    <!-- Mastodon -->
    <a rel="me" href="https://mastodon.social/@sigmarootpi" style="display:none;">Mastodon</a>

    <!-- Adding github for IndieAuth -->
    <link rel="me" href="https://github.com/rishabhstein">

    <!-- Mochi webmention  -->
    <link rel="webmention" href="https://mochi-webmentions.meadow.cafe/webmention/sigmarootpi/1/receive" />
    <!-- Le styles -->
    <link rel="stylesheet" href="/assets/css/style.css?v=2.1">
    <link rel="stylesheet" href="/assets/css/mastodon.css?v=2.0">

    <!-- Fav and touch icons -->
    <link rel="icon" type="image/png" href="/assets/logo.png">

    <link rel="alternate" type="application/rss+xml" title="Rishabh's Blog Feed" href="/feed.xml" />
    <script src="/assets/js/sidebar.js" defer></script>
    <script src="/assets/js/activity-heatmap.js" defer></script>
    <script src="/assets/js/workout-tabs.js" defer></script>
    <audio id="sidebar-music" src="/assets/sounds/blog_background.mp3" preload="auto" loop></audio>

</head>
<body>

  <!-- Its njk format comment here -->
  {#
    <link rel="stylesheet" href="/assets/css/snow.css?v=2.0">
    <link rel="stylesheet" href="/assets/css/christmas-light.css">
    {% include 'christmas-theme.njk' %}
  #}


    {% include 'header.njk' %}
    <main>
    <button class="toggle-sidebar">🎶 Music</button>
    <div class="layout-wrapper">
    <div class="main-content">

      {{ content | safe }}

    </div> <!--main content end-->

    {% include 'sidebar-right.njk'%}

    <div class="overlay"></div>

    </div> <!-- layout-wrapper end -->
    </main>

    {% include 'footer.njk' %}


    <!-- For Mastodon Feed -->
    <script src="/assets/js/mastodon.js"></script>
    <script>
        const myTimeline = new MastodonTimeline.Init({
          instanceUrl: "https://mastodon.social",
          timelineType: "profile",
          userId: "115311770892730280",
          profileName: "@sigmarootpi",
          maxNbPostShow: "5",
          txtMaxLines: "3",
        });
      </script>



</body>
</html>
