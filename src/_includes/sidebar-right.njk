{% set activityHeatmapItems = collections.workoutArchive %}
{% set activityHeatmapTitle = "Workout Days" %}
{% set activityHeatmapLabelSingular = "workout" %}
{% set activityHeatmapLabelPlural = "workouts" %}
{% set activityHeatmapTitleUrl = "/workout/" %}
{% if collections.workoutArchive.length %}
  {% set activityHeatmapInitialMonth = collections.workoutArchive[0].date | isoDate %}
{% endif %}
{% set activityHeatmapMonthLinkPrefix = (site.pathPrefix or "/") ~ "workout/" %}
{% include "activity-heatmap.njk" %}

<h3><a href="/workout/">Recent Activities</a></h3>
<ul class="portal-list sidebar-activity-list">
  {% for workout in collections.workoutArchive %}
    {% if loop.index <= 4 %}
      <li>
        <a href="/workout/{{ workout.date.getFullYear() }}/">{{ workout.data.title }}</a>
        <span class="sidebar-activity-meta">{{ workout.date | postDate }}{% if workout.data.distance %} · {{ workout.data.distance }} km{% endif %}</span>
      </li>
    {% endif %}
  {% endfor %}
</ul>

{% set recentSnaps = collections.snap | reverse %}
<h3><a href="/snap/">Picture Gallery</a></h3>
{% if recentSnaps[0] %}
  <div class="sidebar-photo-feature">
    <a href="{{ recentSnaps[0].url }}" class="sidebar-photo-thumb">
      <img src="{{ recentSnaps[0].data.cover }}" alt="{{ recentSnaps[0].data.title or recentSnaps[0].title }}">
    </a>
    <a href="{{ recentSnaps[0].url }}" class="sidebar-photo-title">{{ recentSnaps[0].data.title or recentSnaps[0].title }}</a>
  </div>
{% endif %}

<ul class="portal-list sidebar-photo-list">
  {% for post in recentSnaps | offset(1) %}
    {% if loop.index <= 3 %}
      <li><a href="{{ post.url }}"><img src="/assets/icons/fb-photos.png" class="sidebar-photo-icon" alt="" data-no-image-reveal>{{ post.data.title or post.title }}</a></li>
    {% endif %}
  {% endfor %}
</ul>

<h3><a href="/tags/word-vomit/">Word-vomit series</a></h3>
<ul class="portal-list">
  {% for post in collections["word-vomit"] | reverse %}
    {% if loop.index <= 5 %}
      <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
    {% endif %}
  {% endfor %}
</ul>
