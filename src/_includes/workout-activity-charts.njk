{# Reusable workout activity chart block. Pass `workoutChartItems` before including it. #}
{% if workoutChartMonthSeriesYear %}
  {% set monthlyBars = workoutChartItems | workoutMonthSeries(workoutChartMonthSeriesYear) %}
{% else %}
  {% set monthlyBars = workoutChartItems | workoutMonthSeriesRolling(12) %}
{% endif %}

<section class="workout-log-section workout-chart-section">
  <h2 class="telegraph-section-title">Activity Rhythm</h2>
  <section class="workout-bar-chart">
    <div class="workout-bar-chart-header">
      <h3>Monthly</h3>
    </div>
    <div class="workout-bars" aria-label="Monthly workout activity bar chart">
      {% for bar in monthlyBars %}
        {% if bar.linkUrl %}
          <a
            class="workout-bar-item workout-bar-link{% if bar.isCurrent %} is-current{% endif %}{% if bar.isEmpty %} is-empty{% endif %}"
            href="{{ bar.linkUrl }}"
            title="{{ bar.label }}: {{ bar.count }} workouts"
          >
            <div class="workout-bar-track">
              <div class="workout-bar-fill{% if bar.isEmpty %} is-empty{% endif %}" style="height: {{ bar.heightPercent }}%;"></div>
            </div>
            <span class="workout-bar-label">{{ bar.shortLabel }}</span>
          </a>
        {% else %}
          <div class="workout-bar-item{% if bar.isCurrent %} is-current{% endif %}{% if bar.isEmpty %} is-empty{% endif %}" title="{{ bar.label }}: {{ bar.count }} workouts">
            <div class="workout-bar-track">
              <div class="workout-bar-fill{% if bar.isEmpty %} is-empty{% endif %}" style="height: {{ bar.heightPercent }}%;"></div>
            </div>
            <span class="workout-bar-label">{{ bar.shortLabel }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </section>
</section>
