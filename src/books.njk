---
title: Book Reviews
layout: 'base.njk'
---

<h4>{{ title }}</h4>

<div data-pagefind-ignore>
  {% set currentYear = collections.bookArchiveYears | first %}
  <p>
    Years:
    {% for year in collections.bookArchiveYears %}
      <a href="/books/{{ year }}/">{{ year }}</a>{% if not loop.last %} | {% endif %}
    {% endfor %}
  </p>

  <h4>{{ currentYear }}</h4>

  {% set yearBooks = collections.bookArchive | itemsForYear(currentYear) %}
  {% for month in yearBooks | groupByMonth %}
    <section class="archive-month" id="month-{{ month.key }}">
      <h5 class="archive-month-title">
        {{ month.monthName }}
        <span class="archive-month-count">{{ month.items.length }} {% if month.items.length == 1 %}book{% else %}books{% endif %}</span>
      </h5>
      <div class="book-section-grid">
        {% for book in month.items %}
          <div class="book-entry-grid">
            <a href="{{ book.url }}" class="book-cover">
              <img src="{{ book.data.cover | assetUrl }}" alt="{{ book.title }}">
              <div class="star-rating">
                {% for i in range(book.data.rating) %}⭐{% endfor %}
              </div>
            </a>
          </div>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</div>
