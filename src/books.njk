---
    title: Book Reviews
    layout: 'base.njk'
---

<h4>{{ title }}</h4>

<h3>Reading:</h3>
<section class="book-section-grid">
    {% for book in collections.books | reverse %}
        {% if book.data.status == "Reading" %}
            <div class="book-entry-grid">
                <a href= "{{ book.url }}">
                <img src="{{ book.data.cover }}" alt="{{ book.title }}">
                </a>
            </div>
        {% endif %}
    {% endfor %}
</section>

<br>

<h3>Finished:</h3>
<section class="book-section-grid">
    {% for book in collections.books | reverse %}
        {% if book.data.status == "Finished" %}
            <div class="book-entry-grid">
                <a href= "{{ book.url }}">
                <img src="{{ book.data.cover }}" alt="{{ book.title }}">
                </a>
            </div>
        {% endif %}
    {% endfor %}
</section>
