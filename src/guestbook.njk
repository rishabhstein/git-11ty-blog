<p>I will really appreciate if you sign my guestbook.</p>

<div>
<script async src="https://guestbooks.meadow.cafe/resources/js/embed_script/325/script.js"></script>
<div id="guestbooks___guestbook-form-container">
    <form id="guestbooks___guestbook-form" action="https://guestbooks.meadow.cafe/guestbook/325/submit" method="post">
        <div class="guestbooks___input-container">
            <label for="name">Your name</label>
            <input placeholder="Name" type="text" id="name" name="name" required>
        </div>
        <div class="guestbooks___input-container">
            <label for="website">Your website <span class="guestbooks___optional">(optional)</span></label>
            <input placeholder="https://..." type="url" id="website" name="website">
        </div>
        <div id="guestbooks___challenge-answer-container"></div>
        <div class="guestbooks___input-container">
            <label for="text">Your comment</label>
            <textarea placeholder="Message (plain text only)..." id="text" name="text" required></textarea>
        </div>
        <input type="submit" value="Sign the guestbook">
        <div id="guestbooks___error-message"></div>
    </form>
</div>
<div id="guestbooks___guestbook-made-with">
    <small>Lovingly made with <a target="_blank" href="https://guestbooks.meadow.cafe">Guestbooks</a></small>
</div>

<hr style="margin: 1em 0;"/>
<h3 id="guestbooks___guestbook-messages-header">Messages</h3><br>
<div id="guestbooks___guestbook-messages-container"></div>
</div>

