---
layout: 'base.njk'
pagination:
  data: collections.postArchiveYears
  size: 1
  alias: archiveYear
permalink: "/archives/{{ archiveYear }}/"
eleventyExcludeFromCollections: true
---

<p>Filter them with:
  <a href="/tags/">tags</a>
</p>

<p class="archive-years">
  Years:
  {% for year in collections.postArchiveYears %}
    <a href="/archives/{{ year }}/">{{ year }}</a>{% if not loop.last %} | {% endif %}
  {% endfor %}
</p>

<h4>{{ archiveYear }}</h4>
<ul class="blog-posts">
  {% for post in collections.postArchive | itemsForYear(archiveYear) %}
    <li>
      <span>{{ post.date | postDate }}</span>
       —
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </li>
  {% endfor %}
</ul>
