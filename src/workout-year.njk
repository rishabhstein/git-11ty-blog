---
layout: 'base.njk'
title: Workout Log
pagination:
  data: collections.workoutArchiveYears
  size: 1
  alias: archiveYear
permalink: "/workout/{{ archiveYear }}/"
eleventyExcludeFromCollections: true
---

{% set yearWorkouts = collections.workoutArchive | itemsForYear(archiveYear) %}
{% set yearMonths = yearWorkouts | groupWorkoutsByMonth %}
{% set activeMonth = yearMonths | first %}
{% set latestWorkout = yearWorkouts | first %}
{% set yearSummary = yearWorkouts | workoutSummary %}
{% set workoutChartItems = yearWorkouts %}
{% set workoutChartMonthSeriesYear = archiveYear %}
{% set activityHeatmapItems = yearWorkouts %}
{% set activityHeatmapShowTitle = false %}
{% set activityHeatmapLabelSingular = "workout" %}
{% set activityHeatmapLabelPlural = "workouts" %}
{% set activityHeatmapStyle = "strip" %}
{% set activityHeatmapMonthLinkPrefix = "#month-" %}
{% set activityHeatmapSyncTarget = "#workout-months-" ~ archiveYear %}
{% if yearWorkouts.length %}
  {% set activityHeatmapInitialMonth = yearWorkouts[0].date | isoDate %}
{% endif %}
{% set activityHeatmapMinMonth = archiveYear ~ "-01-01" %}
{% set activityHeatmapMaxMonth = archiveYear ~ "-12-01" %}

<article class="main-article workout-log-page">
  <h1>{{ title }}: {{ archiveYear }}</h1>

  <section class="workout-log-section">
    <h2 class="telegraph-section-title">Years</h2>
    <ul class="workout-year-links">
      {% for year in collections.workoutArchiveYears %}
        <li><a href="/workout/{{ year }}/">{{ year }}</a></li>
      {% endfor %}
    </ul>
  </section>

  <p>
    {{ yearSummary.totalActivities | formatNumber }} workouts
    {% if yearSummary.totalDistanceKm %} · {{ yearSummary.totalDistanceKm }} km{% endif %}
    {% if yearSummary.totalDurationLabel %} · {{ yearSummary.totalDurationLabel }}{% endif %}
  </p>

  {% include "workout-activity-charts.njk" %}

  <section class="workout-log-section workout-month-overview">
    <h2 class="telegraph-section-title" data-workout-month-overview-title>
      {% if activeMonth %}{{ activeMonth.label }}{% else %}Monthly Activity{% endif %}
    </h2>
    {% include "activity-heatmap.njk" %}
  </section>

  <div id="workout-months-{{ archiveYear }}">
    {% for month in yearMonths %}
      {% set monthSummary = month.items | workoutSummary %}
      <section class="workout-log-section workout-month-panel" data-workout-month="{{ month.key }}">
        <h2 id="month-{{ month.key }}" class="telegraph-section-title">{{ month.label }}</h2>
        <p class="workout-month-summary">
          {{ monthSummary.totalActivities | formatNumber }} workouts
          {% if monthSummary.totalDistanceKm %} · {{ monthSummary.totalDistanceKm }} km{% endif %}
          {% if monthSummary.totalDurationLabel %} · {{ monthSummary.totalDurationLabel }}{% endif %}
        </p>
        <ul class="blog-posts workout-year-list">
          {% for workout in month.items %}
            <li>
              {% set workoutMeta = [] %}
              {% if workout.data.distance %}{% set workoutMeta = (workoutMeta.push(workout.data.distance + " km"), workoutMeta) %}{% endif %}
              {% if workout.data.duration %}{% set workoutMeta = (workoutMeta.push(workout.data.duration | formatWorkoutDuration), workoutMeta) %}{% endif %}
              {% if workout.data.calories %}{% set workoutMeta = (workoutMeta.push(workout.data.calories + " cal"), workoutMeta) %}{% endif %}
              {% if workout.data.average_heart_rate %}{% set workoutMeta = (workoutMeta.push(workout.data.average_heart_rate + " bpm"), workoutMeta) %}{% endif %}
              {% set workoutDetails = [] %}
              {% if workout.data.workout_type %}{% set workoutDetails = (workoutDetails.push(["Type", workout.data.workout_type]), workoutDetails) %}{% endif %}
              {% if workout.data.distance %}{% set workoutDetails = (workoutDetails.push(["Distance", workout.data.distance + " km"]), workoutDetails) %}{% endif %}
              {% if workout.data.duration %}{% set workoutDetails = (workoutDetails.push(["Duration", workout.data.duration | formatWorkoutDuration]), workoutDetails) %}{% endif %}
              {% if workout.data.calories %}{% set workoutDetails = (workoutDetails.push(["Calories", workout.data.calories]), workoutDetails) %}{% endif %}
              {% if workout.data.average_heart_rate %}{% set workoutDetails = (workoutDetails.push(["Average heart rate", workout.data.average_heart_rate + " bpm"]), workoutDetails) %}{% endif %}
              {% if workout.data.source %}{% set workoutDetails = (workoutDetails.push(["Source", workout.data.source]), workoutDetails) %}{% endif %}

              <details class="workout-log-item"{% if workout.url == latestWorkout.url %} open{% endif %}>
                <summary class="workout-log-summary">
                  <span class="workout-log-date">{{ workout.date | postDate }}</span>
                  <span class="workout-log-title">{{ workout.data.title }}</span>
                  {% if workoutMeta.length %}
                    <span class="workout-log-meta">
                      {% for item in workoutMeta %}
                        <span>{{ item }}</span>{% if not loop.last %}<span> · </span>{% endif %}
                      {% endfor %}
                    </span>
                  {% endif %}
                </summary>

                <div class="workout-log-body">
                  {% if workoutDetails.length %}
                    <ul class="workout-detail-list">
                      {% for item in workoutDetails %}
                        <li><strong>{{ item[0] }}:</strong> {{ item[1] }}</li>
                      {% endfor %}
                    </ul>
                  {% endif %}

                  {# Same path as the single-workout page: templateContent is
                     markdown-rendered, but the importer's <p> wrapper stops
                     markdown inside it from being processed. workoutBody
                     unwraps first, then renders. #}
                  {% set yearWorkoutBody = workout.inputPath | workoutBody %}
                  {% if yearWorkoutBody | trim %}
                    <div class="workout-summary-block">
                      <h5>Summary</h5>
                      {{ yearWorkoutBody | safe }}
                      {% if workout.data.cover %}
                        <figure class="workout-post-cover">
                          <img src="{{ workout.data.cover | assetUrl }}" alt="Cover for {{ workout.data.title }}">
                        </figure>
                      {% endif %}
                      {% workoutPlots workout.inputPath, workout.data.plot_svgs %}
                    </div>
                  {% endif %}
                </div>
              </details>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
</article>

<script src="/assets/js/activity-heatmap.js" defer></script>
<script src="/assets/js/workout-accordion.js" defer></script>
